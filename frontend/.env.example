# Адрес API, с которого фронтенд делает запросы. По умолчанию /api — его проксирует dev-сервер.
VITE_API_URL=/api
# Куда dev-сервер проксирует /api (только для npm run dev).
VITE_BACKEND_URL=http://localhost:8000
# Адрес вебсокетов, если он отличается от API. Пусто — тот же хост, что и VITE_API_URL.
VITE_WS_URL=
