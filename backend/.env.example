# Значения для локального запуска через docker compose. Для своих настроек создайте .env рядом:
# он переопределяет этот файл и не попадает в git.

DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/credit

# Только для локальной разработки. В любом общем окружении замените на случайную строку от 32 байт.
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
JWT_TTL_MINUTES=60

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_FILES=credit-files
S3_BUCKET_CONTRACTS=credit-contracts
PRESIGNED_TTL_SECONDS=300
MAX_UPLOAD_MB=10

PIPELINE_STEP_DELAY_MS=800
SOURCE_RETRY_ATTEMPTS=3
SOURCE_RETRY_PAUSE_MS=500
OFFER_TTL_DAYS=7
SIGNING_CODE_TTL_SECONDS=300

DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173

# Пароль всех тестовых учёток из seed.py (логины в README). Только для локального демо.
SEED_PASSWORD=demo-password-2026

# Читают только тесты: эта база пересоздаётся на каждом прогоне.
# TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/credit_test
# MinIO для тестов хранилища и e2e, тесты пишут в бакеты credit-files-test и credit-contracts-test.
# TEST_S3_ENDPOINT=http://localhost:9000
# TEST_S3_ACCESS_KEY=minioadmin
# TEST_S3_SECRET_KEY=minioadmin
